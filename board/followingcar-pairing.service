[Unit]
Description=FollowingCar Bluetooth hotspot provisioning
After=bluetooth.service NetworkManager.service
Requires=bluetooth.service NetworkManager.service
PartOf=bluetooth.service
ConditionPathExists=/etc/followingcar-pairing.json

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/followingcar-pairing/app_bluetooth_provision.py
# BlueZ can release a registered profile with a clean daemon exit. Restart that
# case as well; an explicit systemctl stop still keeps this service stopped.
Restart=always
RestartSec=5
TimeoutStopSec=180
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/topeet/lianzhan/.app_joystick.lock
ReadWritePaths=/home/topeet/Desktop/rk_car_runtime_module/.follow_session.lock
StateDirectory=followingcar-pairing
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
