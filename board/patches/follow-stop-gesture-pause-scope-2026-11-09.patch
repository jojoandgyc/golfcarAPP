+def test_non_gesture_stop_after_pause_restores_100_rpm_fault_even_if_stop_is_throttled(board):
+    motor, backend, clock = board
+    motor.set_gesture_paused(True)
+    motor.write(intent(clock, reason="gesture_paused"))
+    clock.now += .1
+    backend.rpm = (900, 0)
+    assert motor.feedback()["stop_monitor"]["fault"] is None
+    # The new STOP reason may not reach the wire due to refresh throttling;
+    # the live gate state must still end the paused exemption.
+    motor.set_gesture_paused(False)
+    clock.now += .01
+    assert motor.write(intent(clock, reason="capture_inactive"))["dispatched"] is False
+    backend.rpm = (101, 0)
+    clock.now += .1
+    assert motor.feedback()["stop_monitor"]["consecutive_samples"] == 1
+    clock.now += .1
+    with pytest.raises(BoardStopMotionFault) as caught:
+        motor.feedback()
+    assert caught.value.diagnostics["feedback"]["stop_monitor"]["fault"]["threshold_rpm"] == 100.
+
+
+def test_resumed_motion_then_normal_stop_preserves_original_grace_and_threshold(board):
+    motor, backend, clock = board
+    motor.set_gesture_paused(True)
+    motor.write(intent(clock, reason="gesture_paused"))
+    clock.now += .1
+    backend.rpm = (900, -900)
+    assert motor.feedback()["stop_monitor"]["fault"] is None
+    motor.set_gesture_paused(False)
+    clock.now += .1
+    motor.write(intent(clock, stop=False, left=40, right=-40, reason="gesture_resume"))
+    backend.rpm = (40, -40)
+    clock.now += .1
+    assert motor.feedback()["stop_monitor"]["state"] == "moving"
+    motor.write(intent(clock, reason="capture_inactive"))
+    stop_at = clock.now
+    grace = motor.stop_monitor.snapshot()["grace_sec"]
+    assert grace > 0
+    backend.rpm = (101, 0)
+    clock.now = stop_at + grace - .01
+    assert motor.feedback()["stop_monitor"]["reason"] == "deceleration_grace"
+    clock.now = stop_at + grace + .01
+    assert motor.feedback()["stop_monitor"]["consecutive_samples"] == 1
+    clock.now += .1
+    with pytest.raises(BoardStopMotionFault) as caught:
+        motor.feedback()
+    assert caught.value.diagnostics["feedback"]["stop_monitor"]["fault"]["threshold_rpm"] == 100.
 
 
