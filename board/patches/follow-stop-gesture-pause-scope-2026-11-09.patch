+def test_feedback_receives_current_gesture_pause_even_when_stop_reason_is_obstacle(rig):
+    """The feedback policy follows the gate, not a STOP reason overwritten by hazards."""
+    class GestureSignalMotor(ReceiptMotor):
+        def __init__(self):
+            super().__init__()
+            self.gesture_paused = None
+            self.stop_reason = None
+            self.feedback_states = []
+
+        def set_gesture_paused(self, paused):
+            self.gesture_paused = paused
+
+        def feedback(self):
+            self.feedback_states.append((self.gesture_paused, self.stop_reason))
+            return None
+
+    motor = GestureSignalMotor()
+    runtime = waiting_runtime(rig, motor)
+    cases = [
+        ("WAITING", "gesture_waiting", False),
+        ("PAUSED", "gesture_paused", True),
+        ("PAUSED", "obstacle", True),
+        ("RUNNING", "gesture_paused", False),
+        ("WAITING", "gesture_waiting", False),
+    ]
+    for gate_state, stop_reason, expected_pause in cases:
+        runtime.gesture_gate.state = gate_state
+        motor.stop_reason = stop_reason
+        runtime._update_feedback()
+        assert motor.feedback_states[-1] == (expected_pause, stop_reason)
+    assert len(motor.feedback_states) == len(cases)
 
 
