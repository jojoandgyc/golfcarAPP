+    def can_recover_speed_write_timeout(self, failed_sequence: int) -> bool:
+        """Only a complete two-word speed request with an entirely missing ACK."""
+        row = self.last_transaction or {}
+        first = self._first_fault_transaction or {}
+        try:
+            request = bytes.fromhex(row.get("tx_hex", ""))
+            return bool(
+                self.rx_uncertain and failed_sequence is not None
+                and row.get("seq") == first.get("seq") == failed_sequence
+                and self._recovery_attempted_sequence != failed_sequence
+                and row.get("error_type") == "TimeoutError"
+                and not row.get("timeout_restore_error")
+                and row.get("stage") == "read" and row.get("rx_length") == 0
+                and row.get("tx_written") == row.get("tx_length") == 13
+                and len(request) == 13 and request[1] == 0x10
+                and int.from_bytes(request[2:4], "big") in (0x0041, 0x0045)
