+                                expected += _crc(expected).to_bytes(2, "little")
+                                self._validate(expected, bytes(response), 8)
+                            else:
+                                self._validate(request, bytes(response), 8)
+                            if len(report["discarded_late_frames"]) >= (3 if stop_refresh else 1):
