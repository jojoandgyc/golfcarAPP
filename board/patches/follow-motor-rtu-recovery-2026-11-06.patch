+def test_stop_during_recovery_cancels_after_verified_stop_without_rearming_motion():
+    backend, guard, wire, _ = backend_with_responses(*responses("right"))
+    decisions = iter([True, False])
+    with pytest.raises(MotionWriteCancelled, match="stop_requested") as ended:
+        recover(backend, check=lambda: next(decisions))
+    assert ended.value.partial is False
+    assert not backend.motion_write_fault and not guard.rx_uncertain
+    assert not backend.motion_armed and backend.last_speed_receipt is None
+    assert backend.last_motion_recovery["stop_requested_after_recovery"] is True
+    assert all(p[1] != 16 for p in wire.writes)
+
