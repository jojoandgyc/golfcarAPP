+        MotionIntent=lambda sequence, behavior, left, right, speed, now, expires, reason, stop:
+            SimpleNamespace(sequence=sequence, behavior=behavior, left_rpm=left, right_rpm=right,
+                reason=reason, stop=stop, session_id=1))
+    exec(compile(ast.Module(body=[receipt, method], type_ignores=[]), str(path), "exec"), scope)
+    from continuous_follow.hardware import BoardMotor
