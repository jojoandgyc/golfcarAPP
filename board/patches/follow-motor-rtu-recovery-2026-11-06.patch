+"""Fake serial only: no serial import, device open, or board service."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import logging
+import threading
+import time
+import traceback
+
+import pytest
+
+from car_control_modular.motor_rtu import RtuLinkUncertain, RtuProtocolError
+from car_control_modular.mssd_motor import (
+    MssdMotorBackend, MotionWriteCancelled, MotionWriteRecovered,
+)
+from test_motor_rtu import (
+    setup, frame, RIGHT_SPEED, LEFT_SPEED, RIGHT_ACK, LEFT_ACK,
+    RIGHT_STOP, LEFT_STOP, READ_LEFT,
+)
+
+FENCE = frame("01 03 06 00 01 00 02 00 03")
+
+
+def snapshot(left=0, right=0, fault=0):
+    words = [0]*20
+    words[1:3] = [(right & 0xffffffff) >> 16, right & 0xffff]
+    words[11:13] = [(left & 0xffffffff) >> 16, left & 0xffff]
+    words[3] = fault
+    return frame(bytes((1, 3, 40))+b"".join(v.to_bytes(2, "big") for v in words))
+
+
+def failed_speed(*responses, packet=RIGHT_SPEED):
+    guard, wire, clock = setup(b"", *responses)
+    with pytest.raises(TimeoutError):
+        guard.transact(packet, 8)
+    return guard, wire, clock, guard.last_transaction["seq"]
+
+
+def normal_responses():
+    return [RIGHT_STOP, LEFT_STOP, FENCE, snapshot(), snapshot()]
+
+
+@pytest.mark.parametrize("packet", [RIGHT_SPEED, LEFT_SPEED])
+def test_recovery_stops_both_synchronizes_and_reads_two_fresh_zeros_without_speed_retry(packet):
+    guard, wire, clock, seq = failed_speed(*normal_responses(), packet=packet)
+    result = guard.recover_speed_write_timeout(seq)
+    assert wire.writes[0] == packet
+    assert [p[1] for p in wire.writes] == [16, 6, 6, 3, 3, 3]
+    assert [int.from_bytes(p[2:4], "big") for p in wire.writes] == [
+        int.from_bytes(packet[2:4], "big"), 0x40, 0x44, 0, 8, 8]
+    assert result["recovery"]["stop_acknowledged"] == ["right", "left"]
+    assert result["recovery"]["zero_samples"] == 2
+    assert result["recovery"]["outcome"] == "recovered"
+    assert not guard.rx_uncertain
+    assert wire.timeout == .15 and wire.write_timeout is None
+    assert result["recovery"]["elapsed_ms"] < 600
+
+
+@pytest.mark.parametrize("where", range(5))
+def test_late_old_ack_is_discarded_and_cannot_certify_any_recovery_step(where):
+    responses = normal_responses()
+    responses[where] = RIGHT_ACK+responses[where]
+    guard, wire, _, seq = failed_speed(*responses)
+    result = guard.recover_speed_write_timeout(seq)
+    assert result["recovery"]["discarded_late_frames"] == [RIGHT_ACK.hex()]
+    assert len([p for p in wire.writes if p[1] == 16]) == 1
+
+
+def test_old_speed_ack_alone_never_substitutes_for_stop_and_both_stops_are_attempted():
+    guard, wire, _, seq = failed_speed(RIGHT_ACK, LEFT_STOP)
+    first = guard.fault_reason
+    with pytest.raises(TimeoutError):
+        guard.recover_speed_write_timeout(seq)
+    assert guard.rx_uncertain and guard.fault_reason == first
+    assert wire.writes == [RIGHT_SPEED, RIGHT_STOP, LEFT_STOP]
+    assert guard.last_recovery["stop_acknowledged"] == ["left"]
+
+
+@pytest.mark.parametrize("packet", [
+    RIGHT_STOP, READ_LEFT, frame("01 10 00 6d 00 01 02 00 00"),
+    frame("01 06 00 41 00 00"),
+])
+def test_stop_read_parameter_or_wrong_function_timeout_is_never_speed_recovery(packet):
+    guard, wire, _, seq = failed_speed(packet=packet)
+    before = list(wire.writes)
+    assert not guard.can_recover_speed_write_timeout(seq)
+    with pytest.raises(RtuLinkUncertain):
+        guard.recover_speed_write_timeout(seq)
+    assert wire.writes == before
+
+
+@pytest.mark.parametrize("response", [
+    RIGHT_ACK[:3], RIGHT_ACK[:-1]+b"\0", LEFT_ACK, frame("01 90 05"), frame("01 90 04"),
+])
+def test_partial_crc_or_mismatched_original_response_stays_fatal(response):
+    guard, wire, _ = setup(response)
+    with pytest.raises((TimeoutError, RtuProtocolError)):
+        guard.transact(RIGHT_SPEED, 8)
+    assert not guard.can_recover_speed_write_timeout(guard.last_transaction["seq"])
+
+
+@pytest.mark.parametrize("side", [0, 1])
+def test_missing_stop_ack_cannot_clear_fault_even_when_other_side_answers(side):
+    responses = normal_responses()
+    responses[side] = b""
+    guard, wire, _, seq = failed_speed(*responses)
+    with pytest.raises(TimeoutError):
+        guard.recover_speed_write_timeout(seq)
+    assert guard.rx_uncertain
+    assert wire.writes[1:3] == [RIGHT_STOP, LEFT_STOP]
+    assert len(wire.writes) == 3
+
+
+@pytest.mark.parametrize("failed_at", [2, 3, 4])
+def test_failed_fence_or_snapshot_cannot_recover(failed_at):
+    responses = normal_responses()
+    responses[failed_at] = b""
+    guard, wire, _, seq = failed_speed(*responses)
+    with pytest.raises(TimeoutError):
+        guard.recover_speed_write_timeout(seq)
+    assert guard.rx_uncertain
+    assert len([p for p in wire.writes if p[1] == 16]) == 1
+
+
+def test_hardware_error_is_not_hidden_by_later_clear_snapshot():
+    guard, wire, _, seq = failed_speed(RIGHT_STOP, LEFT_STOP, FENCE, snapshot(fault=7), snapshot())
+    with pytest.raises(RuntimeError, match="hardware fault"):
+        guard.recover_speed_write_timeout(seq)
+    assert guard.rx_uncertain
+    assert len(wire.writes) == 5
+
+
+def test_nonzero_feedback_requires_two_later_zeros_and_has_bounded_deadline():
+    guard, wire, _, seq = failed_speed(RIGHT_STOP, LEFT_STOP, FENCE,
+        snapshot(left=1), snapshot(), snapshot(right=-2), snapshot(), snapshot())
+    result = guard.recover_speed_write_timeout(seq)
+    assert result["recovery"]["zero_samples"] == 2
+    assert len(wire.writes) == 9
+    guard, wire, clock, seq = failed_speed(RIGHT_STOP, LEFT_STOP, FENCE, *([snapshot(left=1)]*20))
+    start = clock()
+    with pytest.raises(TimeoutError):
+        guard.recover_speed_write_timeout(seq, budget_sec=.1)
+    assert clock()-start <= .100001
+    assert guard.rx_uncertain
+
+
+def test_true_disconnect_attempts_both_stop_sides_and_never_retries_old_motion():
+    guard, wire, clock, seq = failed_speed()
+    start = clock()
+    with pytest.raises(TimeoutError):
+        guard.recover_speed_write_timeout(seq)
+    assert clock()-start <= .300001
+    assert wire.writes == [RIGHT_SPEED, RIGHT_STOP, LEFT_STOP]
+    assert guard.rx_uncertain
+    before = list(wire.writes)
+    with pytest.raises(RtuLinkUncertain):
+        guard.transact(RIGHT_SPEED, 8)
+    assert wire.writes == before
+
+
+def backend_with_responses(*responses):
+    guard, wire, clock = setup(*responses)
+    config = SimpleNamespace(forward_target_sign=1, left_sign=1, right_sign=1,
+        max_target=200, stop_mode="emergency", stop_zero_delay_sec=0)
+    backend = MssdMotorBackend(config, logger=logging.getLogger("fake.backend"))
+    backend._rtu_guard = guard
+    def speed(address, rpm):
+        payload = bytes((1, 16))+address.to_bytes(2, "big")+b"\0\2\4"+int(rpm).to_bytes(4, "big", signed=True)
+        return guard.transact(frame(payload), 8)
+    backend.driver = SimpleNamespace(
+        set_right_speed=lambda rpm: speed(0x41, rpm),
+        set_left_speed=lambda rpm: speed(0x45, rpm),
+        stop=lambda side, mode: guard.transact(frame(bytes((1, 6))+
+            (0x40 if side == "right" else 0x44).to_bytes(2, "big")+int(mode).to_bytes(2, "big")), 8))
+    return backend, guard, wire, clock
+
+
+@pytest.mark.parametrize("failed_side", ["right", "left"])
+def test_backend_discards_old_pair_and_only_a_separate_new_call_can_move(failed_side):
+    prefix = [b""] if failed_side == "right" else [RIGHT_ACK, b""]
+    backend, guard, wire, _ = backend_with_responses(*prefix, *normal_responses(), RIGHT_ACK, LEFT_ACK)
+    with pytest.raises(MotionWriteRecovered) as recovered:
+        backend._write_speed_pair(31, 29, "CONTINUOUS", recover_empty_timeout=True)
+    assert isinstance(recovered.value, MotionWriteCancelled)
+    assert recovered.value.partial is False
+    assert not backend.motion_write_fault and not guard.rx_uncertain
+    assert backend.last_speed_receipt is None and backend.last_speed_write is None
+    assert not backend.motion_armed
+    assert len([p for p in wire.writes if p[1] == 16]) == len(prefix)
+    # New targets prove this is not resending the pair from the exception.
+    backend._write_speed_pair(12, 11, "new_decision")
+    assert backend.last_speed_receipt.left_rpm == 12
+    assert backend.last_speed_receipt.right_rpm == 11
+    assert int.from_bytes(wire.writes[-2][7:11], "big") == 11
+    assert int.from_bytes(wire.writes[-1][7:11], "big") == 12
+
+
+def test_legacy_backend_does_not_opt_in_and_short_repeat_does_not_recover():
+    backend, guard, wire, _ = backend_with_responses(b"", RIGHT_STOP, LEFT_STOP)
+    with pytest.raises(TimeoutError):
+        backend._write_speed_pair(31, 29, "legacy")
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert all(p[1] != 3 for p in wire.writes)
+    backend, guard, wire, _ = backend_with_responses(b"", *normal_responses(),
+        b"", RIGHT_STOP, LEFT_STOP)
+    with pytest.raises(MotionWriteRecovered):
+        backend._write_speed_pair(31, 29, "continuous", recover_empty_timeout=True)
+    with pytest.raises(TimeoutError):
+        backend._write_speed_pair(32, 30, "continuous", recover_empty_timeout=True)
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert len([p for p in wire.writes if p[1] == 3]) == 3
+
+
+def test_recovery_lock_covers_stop_fence_and_feedback():
+    guard, wire, _, seq = failed_speed(*normal_responses())
+    original_write = wire.write
+    def write(packet):
+        assert not guard._lock.acquire(blocking=False)
+        return original_write(packet)
+    wire.write = write
+    guard.recover_speed_write_timeout(seq)
+    assert guard._lock.acquire(blocking=False)
+    guard._lock.release()
+
+
+@pytest.mark.parametrize("replacement", [
+    RIGHT_STOP[:3], RIGHT_STOP[:-1]+b"\0", LEFT_STOP, RIGHT_ACK+RIGHT_ACK+RIGHT_STOP,
+])
+def test_bad_recovery_frames_never_clear_uncertainty_and_do_not_skip_other_stop(replacement):
+    guard, wire, _, seq = failed_speed(replacement, LEFT_STOP)
+    with pytest.raises((TimeoutError, RtuProtocolError)):
+        guard.recover_speed_write_timeout(seq)
+    assert guard.rx_uncertain
+    assert wire.writes[:3] == [RIGHT_SPEED, RIGHT_STOP, LEFT_STOP]
+
+
+def test_backend_failed_recovery_retains_fault_and_attempts_original_safety_stop():
+    backend, guard, wire, _ = backend_with_responses(b"", b"", LEFT_STOP, RIGHT_STOP, LEFT_STOP)
+    with pytest.raises(RuntimeError, match="speed recovery failed"):
+        backend._write_speed_pair(31, 29, "CONTINUOUS", recover_empty_timeout=True)
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert backend.last_speed_receipt is None
+    assert wire.writes[1:] == [RIGHT_STOP, LEFT_STOP, RIGHT_STOP, LEFT_STOP]
+
+
+@pytest.mark.parametrize("explicit_stop", [False, True])
