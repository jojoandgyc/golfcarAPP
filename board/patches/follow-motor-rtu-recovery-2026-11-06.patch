+                    self._write_timeout_owner.write_timeout = self._remaining(transaction_deadline)
+                    detail["tx_written"] = self.transport.write(packet)
+                    self._last_activity = self._clock()
+                    if detail["tx_written"] != len(packet):
+                        raise RtuProtocolError("short speed-recovery request write")
