+    def _recover_write_timeout(self, failed_sequence: int, *, budget_sec=.6, stop_refresh=False) -> dict:
+        """STOP both sides, fence the stream, then require two fresh zero snapshots.
+
+        This is a continuous-owner opt-in, never a retry of a speed packet.
+        Keep the RTU lock throughout. A late FC10 ACK is identifiable by its
+        exact original address/count, and cannot certify any STOP or feedback.
+        Other corrupt/partial/unknown frames and failed STOPs remain fatal.
+        """
+        if not math.isfinite(float(budget_sec)) or not 0 < float(budget_sec) <= .6:
+            raise ValueError("speed recovery budget must be positive and at most 0.6 seconds")
+        eligible = self.can_recover_emergency_stop_timeout if stop_refresh else self.can_recover_speed_write_timeout
+        if not eligible(failed_sequence):
+            raise RtuLinkUncertain("ineligible write timeout")
+        started = self._clock()
+        deadline = started + float(budget_sec)
+        failed = dict(self._first_fault_transaction if stop_refresh else self.last_transaction)
+        request = bytes.fromhex(failed["tx_hex"])
+        report = dict(kind="periodic_stop_pause" if stop_refresh else "speed_write_pause", failed_sequence=failed_sequence,
+                      failed_transaction=failed, budget_sec=float(budget_sec),
+                      outcome="in_progress", transactions=[], discarded_late_frames=[],
+                      stop_acknowledged=[], zero_samples=0, fence_completed=False,
+                      response_order_assumption="single_master_ordered_rtu")
+        if stop_refresh:
+            report["originalStopOutcome"] = "unknown"
+            report["uncredited_stop_responses"] = []
+        self.last_recovery = report
