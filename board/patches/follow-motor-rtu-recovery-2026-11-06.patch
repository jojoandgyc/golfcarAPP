+@pytest.mark.parametrize("kind", ["initial", "shutdown", "user_stop", "gesture_paused", "changed", "no_guard"])
+def test_board_adapter_only_opts_in_to_established_periodic_same_reason_stop(kind):
+    backend, guard, wire, _ = backend_with_responses(b"", LEFT_STOP)
+    motor = BoardMotor.__new__(BoardMotor)
+    motor.backend, motor.config = backend, backend.config
+    motor._stopped = kind != "initial"
+    motor._last_stop_write_at = time.monotonic()-.25
+    motor._last_stop_reason = "target_lost"
+    motor.stop_recovery_guard = None if kind == "no_guard" else lambda: True
+    reason = kind if kind in ("shutdown", "user_stop", "gesture_paused") else "target_lost"
+    if kind == "changed":
+        motor._last_stop_reason = "other"
+    if kind in ("shutdown", "user_stop", "gesture_paused"):
+        motor._last_stop_reason = reason
+    with pytest.raises(TimeoutError):
+        motor.write(SimpleNamespace(stop=True, reason=reason))
+    assert guard.last_recovery is None
+    assert all(p[1] == 6 for p in wire.writes)
+
