+            self._recovery_attempted_sequence = failed_sequence
+            report.update(outcome="failed", error="speed recovery lock deadline exceeded",
+                          elapsed_ms=(self._clock()-started)*1000)
+            raise TimeoutError(report["error"])
+        success = False
+        saved = False
+        registers = None
+        try:
+            if not eligible(failed_sequence):
+                raise RtuLinkUncertain("write fault changed before recovery lock")
+            self._recovery_attempted_sequence = failed_sequence
+            saved_timeout = self.transport.timeout
+            saved_write_timeout = self._write_timeout_owner.write_timeout
+            saved = True
+            self._reset_owner.reset_input_buffer()
+            self._last_activity = self._clock()
+
+            def transaction(function, address, value, expected_length):
+                packet = bytes((request[0], function)) + address.to_bytes(2, "big") + value.to_bytes(2, "big")
+                packet += _crc(packet).to_bytes(2, "little")
+                self._sequence += 1
+                detail = dict(started=self._clock(), seq=self._sequence, stage="quiet",
+                    thread=threading.current_thread().name, function="0x%02X" % function,
+                    register="0x%04X" % address, tx_hex=packet.hex(), tx_length=8,
+                    tx_written=0, expected_rx_length=expected_length, read_calls=0,
+                    first_rx_ms=None, quiet_wait_ms=0., write_timeout_supported=True,
+                    rx_reset="speed_recovery", recovery_of=failed_sequence)
