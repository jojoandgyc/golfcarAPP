+"""Only periodic emergency STOP refresh may recover; fake wire, no hardware."""
+from types import SimpleNamespace
+import time
+
+import pytest
+
+from car_control_modular.mssd_motor import MotionWriteCancelled
+from continuous_follow.hardware import BoardMotor
+from test_motor_rtu import frame, RIGHT_STOP, LEFT_STOP
+from test_continuous_write_pause import backend_with_responses, FENCE, snapshot
+
+
+def responses(side, *, delayed=b""):
+    initial = [b"", LEFT_STOP] if side == "right" else [RIGHT_STOP, b""]
+    uncredited = [RIGHT_STOP, LEFT_STOP] if side == "right" else [LEFT_STOP, RIGHT_STOP]
+    return initial+uncredited+[delayed+FENCE, RIGHT_STOP, LEFT_STOP, snapshot(), snapshot()]
+
+
+def recover(backend, check=lambda: True, mode=1):
+    backend._checked_stop_wheels("continuous:target_lost", mode,
+        recover_empty_timeout=True, recovery_check=check)
+
+
+@pytest.mark.parametrize("side", ["right", "left"])
+def test_initial_single_missing_stop_tries_both_then_reasserts_before_fence(side):
+    backend, guard, wire, _ = backend_with_responses(*responses(side))
+    recover(backend)
+    assert not backend.motion_write_fault and not guard.rx_uncertain
+    assert wire.writes[:2] == [RIGHT_STOP, LEFT_STOP]
+    failed = RIGHT_STOP if side == "right" else LEFT_STOP
+    other = LEFT_STOP if side == "right" else RIGHT_STOP
+    assert wire.writes[2:4] == [failed, other]  # Before any synchronization read.
+    assert [p[1] for p in wire.writes] == [6, 6, 6, 6, 3, 6, 6, 3, 3]
+    report = backend.last_motion_recovery
+    assert report["originalStopOutcome"] == "unknown"
+    assert report["response_order_assumption"] == "single_master_ordered_rtu"
+    assert report["uncredited_stop_responses"] == [side, "left" if side == "right" else "right"]
+    assert report["fence_completed"] and report["stop_acknowledged"] == ["right", "left"]
+    assert report["zero_samples"] == 2 and report["elapsed_ms"] <= 600
+    assert backend.last_speed_receipt is None
+
+
+@pytest.mark.parametrize("side", ["right", "left"])
+def test_old_same_bytes_during_fence_are_not_counted_as_new_stop_confirmation(side):
+    old = RIGHT_STOP if side == "right" else LEFT_STOP
+    backend, guard, wire, _ = backend_with_responses(*responses(side, delayed=old))
+    recover(backend)
+    report = backend.last_motion_recovery
+    assert report["discarded_late_frames"] == [old.hex()]
+    assert report["originalStopOutcome"] == "unknown"
+    assert report["stop_acknowledged"] == ["right", "left"]
+    assert len([p for p in wire.writes if p[1] == 6]) == 6
+
+
+def test_old_ack_alone_cannot_replace_fence_or_authorize_new_motion():
+    backend, guard, wire, _ = backend_with_responses(b"", LEFT_STOP, RIGHT_STOP, LEFT_STOP,
+        RIGHT_STOP, RIGHT_STOP, LEFT_STOP)
+    with pytest.raises(RuntimeError, match="STOP recovery failed"):
+        recover(backend)
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert not backend.last_motion_recovery["fence_completed"]
+    assert backend.last_motion_recovery["stop_acknowledged"] == []
+    assert all(p[1] != 16 for p in wire.writes)
+
+
+def test_late_known_ack_after_fence_in_wrong_slot_is_fatal_not_relabelled():
+    replies = responses("right")
+    replies[6] = RIGHT_STOP+LEFT_STOP  # LEFT repeat expects LEFT, not old RIGHT.
+    backend, guard, wire, _ = backend_with_responses(*replies, RIGHT_STOP, LEFT_STOP)
+    with pytest.raises(RuntimeError, match="STOP recovery failed"):
+        recover(backend)
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert backend.last_motion_recovery["zero_samples"] == 0
+    assert all(p[1] != 16 for p in wire.writes)
+
+
+@pytest.mark.parametrize("reply", [RIGHT_STOP[:3], RIGHT_STOP[:-1]+b"\0", frame("01 86 05")])
+def test_partial_crc_or_exception_original_stop_is_never_recoverable(reply):
+    backend, guard, wire, _ = backend_with_responses(reply, LEFT_STOP)
+    with pytest.raises(Exception):
+        recover(backend)
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert wire.writes == [RIGHT_STOP, LEFT_STOP]
+    assert guard.last_recovery is None
+
+
+def test_two_missing_original_stop_acks_are_persistent_loss_not_single_transient():
+    backend, guard, wire, _ = backend_with_responses(b"", b"")
+    with pytest.raises(TimeoutError):
+        recover(backend)
+    assert wire.writes == [RIGHT_STOP, LEFT_STOP]
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert guard.last_recovery is None
+
+
+def test_persistent_loss_in_uncredited_reassertion_still_attempts_both_and_exits():
+    backend, guard, wire, _ = backend_with_responses(b"", LEFT_STOP)
+    with pytest.raises(RuntimeError, match="STOP recovery failed"):
+        recover(backend)
+    assert wire.writes[:4] == [RIGHT_STOP, LEFT_STOP, RIGHT_STOP, LEFT_STOP]
+    assert backend.motion_write_fault and guard.rx_uncertain
+    assert not any(p[1] == 3 for p in wire.writes)
+
+
+@pytest.mark.parametrize("mode", [0, 2])
+def test_normal_or_free_stop_never_uses_recovery(mode):
+    reply = frame(bytes((1, 6, 0, 0x44, 0, mode)))
+    backend, guard, wire, _ = backend_with_responses(b"", reply, RIGHT_STOP, LEFT_STOP)
+    with pytest.raises(TimeoutError):
+        recover(backend, mode=mode)
+    assert guard.last_recovery is None and backend.motion_write_fault
+    assert all(p[1] == 6 for p in wire.writes)
+
+
+def test_user_stop_arriving_during_initial_timeout_disables_recovery():
+    backend, guard, wire, _ = backend_with_responses(b"", LEFT_STOP)
+    def stopped():
+        raise MotionWriteCancelled("stop_requested")
+    with pytest.raises(TimeoutError):
+        recover(backend, check=stopped)
+    assert guard.last_recovery is None
+    assert wire.writes == [RIGHT_STOP, LEFT_STOP]
