+        last = self.last_transaction or {}
+        try:
+            packet = bytes.fromhex(first.get("tx_hex", ""))
+            if not (
+                self.rx_uncertain and failed_sequence is not None
+                and first.get("seq") == failed_sequence
+                and self._recovery_attempted_sequence != failed_sequence
+                and first.get("error_type") == "TimeoutError"
+                and not first.get("timeout_restore_error")
+                and first.get("stage") == "read" and first.get("rx_length") == 0
+                and first.get("tx_written") == first.get("tx_length") == 8
+                and len(packet) == 8 and packet[1] == 6
+                and int.from_bytes(packet[2:4], "big") in (0x0040, 0x0044)
+                and packet[4:6] == b"\x00\x01"
+                and self._reset_owner is not None and self._write_timeout_owner is not None):
+                return False
