+def test_board_periodic_stop_receipt_keeps_original_uncertainty_and_clears_no_configuration():
+    backend, guard, wire, _ = backend_with_responses(*responses("left"))
+    motor = BoardMotor.__new__(BoardMotor)
+    motor.backend, motor.config = backend, backend.config
+    motor._stopped = True
+    motor._last_stop_write_at = time.monotonic()-.25
+    motor._last_stop_reason = "target_lost"
+    motor.stop_recovery_guard = lambda: True
+    result = motor.write(SimpleNamespace(stop=True, reason="target_lost"))
+    assert result["kind"] == "stop" and result["acknowledged"] is True
+    assert result["physical_stillness"] == "unverified"
+    assert backend.last_motion_recovery["originalStopOutcome"] == "unknown"
+    assert all(p[1] != 16 for p in wire.writes)
+
