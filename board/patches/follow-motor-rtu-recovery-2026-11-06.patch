+                        # Before the fence, an exact response to the emergency
+                        # reassertion is UNPROVEN: the missing old ACK is identical.
+                        uncredited_match = late_stop and function == 6 and response[:6] == packet[:6]
+                        late_speed = not stop_refresh and response[1] == 0x10
+                        if late_speed or late_stop and not uncredited_match:
+                            if late_stop:
+                                address = int.from_bytes(response[2:4], "big")
+                                if address not in (0x40, 0x44) or response[4:6] != b"\x00\x01":
+                                    raise RtuProtocolError("unknown late STOP response")
