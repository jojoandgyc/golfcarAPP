+def test_stop_recovery_does_not_consult_stale_motion_ttl_or_identity_guard():
+    backend, guard, wire, _ = backend_with_responses(*responses("right"))
+    motor = BoardMotor.__new__(BoardMotor)
+    motor.backend, motor.config = backend, backend.config
+    motor._stopped = True
+    motor._last_stop_write_at = time.monotonic()-.4
+    motor._last_stop_reason = "target_lost"
+    motor.stop_recovery_guard = lambda: True
+    def expired(intent):
+        raise MotionWriteCancelled("intent_expired")
+    motor.motion_guard = expired
+    receipt = motor.write(SimpleNamespace(stop=True, reason="target_lost", expires_at=0))
+    assert receipt["acknowledged"] is True
+    assert backend.last_motion_recovery["zero_samples"] == 2
+    assert all(p[1] != 16 for p in wire.writes)
