@@ -0,0 +1,94 @@
+"""Recovery budget for empty motor-status reads; all motor I/O is faked."""
+from types import SimpleNamespace
+
+import pytest
+
+from test_stop_hardware import Backend, intent
+from test_hardware import parser
+from continuous_follow.hardware import BoardMotor
+
+
+@pytest.fixture
+def board(monkeypatch):
+    import car_control_modular.mssd_motor as module
+    import continuous_follow.hardware as hardware
+
+    backend = Backend()
+    clock = SimpleNamespace(now=10.)
+    monkeypatch.setattr(module, "MssdMotorBackend", lambda _config: backend)
+    monkeypatch.setattr(hardware, "controller_config", lambda _parser:
+        SimpleNamespace(max_rpm=200, deceleration_rpm_s=100))
+    monkeypatch.setattr(hardware.time, "monotonic", lambda: clock.now)
+    motor = BoardMotor(parser(left_sign=1, right_sign=1, forward_target_sign=1))
+    motor.open()
+    return motor, backend, clock
+
+
+def timeout_reads(backend, *, eligible=True):
+    guard = backend._rtu_guard
+    calls = []
+
+    def failed_read(_side):
+        backend.sequence += 1
+        guard.last_transaction = {"seq": backend.sequence, "stage": "read", "rx_length": 0}
+        raise TimeoutError("no response from driver")
+
+    def recover(sequence, *, budget_sec):
+        calls.append((sequence, budget_sec))
+        return {"registers": [0] * 20,
+                "recovery": {"outcome": "recovered", "failed_sequence": sequence}}
+
+    backend.read_motor_status = failed_read
+    guard.can_recover_status_read_timeout = lambda sequence: eligible
+    guard.recover_status_read_timeout = recover
+    return calls
+
+
+def test_two_empty_read_recoveries_in_two_seconds_then_exit(board):
+    motor, backend, clock = board
+    motor.write(intent(clock))
+    calls = timeout_reads(backend)
+    for at in (10.1, 10.6):
+        clock.now = at
+        assert motor.feedback()["recovery"]["outcome"] == "recovered"
+    clock.now = 10.9
+    with pytest.raises(TimeoutError, match="no response"):
+        motor.feedback()
+    assert len(calls) == 2
+    assert all(budget == .08 for _, budget in calls)
+    assert [call[0] for call in backend.calls] == ["stop"]
+
+
+def test_recovery_budget_uses_sliding_window(board):
+    motor, backend, clock = board
+    motor.write(intent(clock))
+    calls = timeout_reads(backend)
+    for at in (10.1, 10.6, 12.2, 12.7):
+        clock.now = at
+        assert motor.feedback()["recovery"]["outcome"] == "recovered"
+    assert len(calls) == 4
+    clock.now = 12.8
+    with pytest.raises(TimeoutError, match="no response"):
+        motor.feedback()
+    assert len(calls) == 4
+
+
+def test_ineligible_or_partial_reply_never_uses_recovery_budget(board):
+    motor, backend, clock = board
+    motor.write(intent(clock))
+    calls = timeout_reads(backend, eligible=False)
+    clock.now += .1
+    with pytest.raises(TimeoutError, match="no response"):
+        motor.feedback()
+    assert not calls
+    assert len(motor._feedback_recovery_attempts) == 0
+
+
+def test_hardware_fault_is_not_a_read_timeout_recovery(board):
+    motor, backend, clock = board
+    motor.write(intent(clock))
+    backend.read_motor_status = lambda _side: SimpleNamespace(error_code=7)
+    clock.now += .1
+    with pytest.raises(RuntimeError, match="hardware fault"):
+        motor.feedback()
+    assert len(motor._feedback_recovery_attempts) == 0
