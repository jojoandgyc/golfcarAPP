+++ b/tests/continuous/test_follow_optional_recovery.py
@@ -0,0 +1,126 @@
+"""Synthetic tests for optional recording and nonblocking status publication."""
+import ast
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+import types
+import unittest
+from unittest import mock
+
+
+STAGE = Path(os.environ.get("FOLLOW_TEST_RUNTIME_ROOT", Path(__file__).resolve().parents[2]))
+sys.path.insert(0, str(STAGE))
+from app_follow_worker import StatusPublisher  # noqa: E402
+
+
+def runtime_method(name):
+    """Execute the staged method itself without importing board-only devices."""
+    tree = ast.parse((STAGE / "continuous_follow" / "runtime.py").read_text(encoding="utf-8"))
+    cls = next(node for node in tree.body
+               if isinstance(node, ast.ClassDef) and node.name == "ContinuousRuntime")
+    method = next(node for node in cls.body
+                  if isinstance(node, ast.FunctionDef) and node.name == name)
+    namespace = {"threading": threading, "time": time, "math": __import__("math"),
+                 "get": lambda _parser, _section, _key, default: default}
+    exec(compile(ast.Module(body=[method], type_ignores=[]), str(STAGE), "exec"), namespace)
+    return namespace[name]
+
+
+class Events:
+    def __init__(self):
+        self.rows = []
+
+    def emit(self, kind, **fields):
+        self.rows.append((kind, fields))
+
+
+class TestOptionalRecording(unittest.TestCase):
+    def test_submit_failure_disables_only_recording_once(self):
+        class Frame:
+            shape = (480, 640, 3)
+
+        class Inputs:
+            calls = 0
+
+            def read(self):
+                self.calls += 1
+                time.sleep(.02)
+                if self.calls == 2:
+                    runtime.stop_event.set()
+                return True, Frame(), time.monotonic()
+
+        class Recorder:
+            calls = 0
+
+            def submit(self, *_args, **_kwargs):
+                self.calls += 1
+                raise OSError("test disk full")
+
+        runtime = types.SimpleNamespace(
+            stop_event=threading.Event(), condition=threading.Condition(),
+            parser=object(), inputs=Inputs(), events=Events(), recorder=Recorder(),
+            _recording_disabled=threading.Event(),
+            _recording_error_lock=threading.Lock(),
+            _wheel_feedback_for_frame=lambda _stamp: None,
+            capture_heartbeat=0, packet=None)
+        runtime._recording_error = types.MethodType(runtime_method("_recording_error"), runtime)
+        runtime_method("_capture_loop")(runtime)
+        self.assertEqual(runtime.recorder.calls, 1)
+        self.assertEqual(len([row for row in runtime.events.rows if row[0] == "capture"]), 2,
+                         runtime.events.rows)
+        failures = [row for row in runtime.events.rows if row[0] == "video_recording_unavailable"]
+        self.assertEqual(len(failures), 1)
+        self.assertEqual(failures[0][1]["stage"], "submit")
+        self.assertTrue(runtime._recording_disabled.is_set())
+
+    def test_camera_read_failure_still_propagates(self):
+        class Inputs:
+            def read(self):
+                raise OSError("test camera disconnect")
+
+        runtime = types.SimpleNamespace(stop_event=threading.Event(),
+            condition=threading.Condition(), parser=object(), inputs=Inputs(),
+            events=Events(), recorder=None, _recording_disabled=threading.Event())
+        with self.assertRaisesRegex(OSError, "camera disconnect"):
+            runtime_method("_capture_loop")(runtime)
+
+
+class TestStatusPublisher(unittest.TestCase):
+    def make_publisher(self):
+        guard = types.SimpleNamespace(stopped=threading.Event(), reason=None,
+                                      request_stop=mock.Mock())
+        snapshot = types.SimpleNamespace(status=lambda: {"runState": "RUNNING"})
+        with mock.patch("app_follow_worker.os.set_blocking"):
+            publisher = StatusPublisher(123, snapshot, guard)
+        return publisher, guard
+
+    def test_single_full_pipe_sample_is_skipped_then_recovers(self):
+        publisher, guard = self.make_publisher()
+        writes = 0
+
+        def write(_fd, data):
+            nonlocal writes
+            writes += 1
+            if writes == 1:
+                raise BlockingIOError("test pipe full")
+            return len(data)
+
+        with mock.patch("app_follow_worker.os.write", side_effect=write):
+            self.assertFalse(publisher.publish())
+            self.assertTrue(publisher.publish())
+        guard.request_stop.assert_not_called()
+
+    def test_broken_pipe_still_stops_worker(self):
+        publisher, guard = self.make_publisher()
+        with mock.patch("app_follow_worker.os.write", side_effect=BrokenPipeError("closed")):
+            publisher.start()
+            publisher.thread.join(1)
+            self.assertFalse(publisher.thread.is_alive())
+            publisher.close()
+        guard.request_stop.assert_called_once_with("app_status_pipe_failed")
+
+
+if __name__ == "__main__":
+    unittest.main()
