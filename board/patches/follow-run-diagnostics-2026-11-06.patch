+"""Bounded run evidence, separate from disposable recordings and camera frames.
+
+Only EventLog's writer (or an explicit offline migration) calls this module. No
+control/capture thread waits for filesystem I/O here. The directory is a private
+diagnostic pool; its JSON records contain no recordings or arbitrary stdout.
+"""
+from collections import deque
+from contextlib import contextmanager
+import datetime
+import fcntl
+import json
+import math
+import os
+from pathlib import Path
+import re
+import stat
+import time
+import uuid
+
+OWNER = "rk_car_runtime_diagnostics"
+VERSION = 1
+MAX_AGE_SECONDS = 7 * 24 * 3600
+MAX_BYTES = 20 * 1024 * 1024
+MAX_EVENT_BYTES = 512 * 1024
+MAX_RECORD_BYTES = 2 * 1024 * 1024
+CONTEXT_BYTES = 256 * 1024
+RUN_NAME = re.compile(r"run_[A-Za-z0-9_]{1,120}\Z")
+TEMP_NAME = re.compile(r"\.tmp_[a-f0-9]{32}\.json\Z")
+FAULTS = {"runtime_failure", "process_failure", "worker_failure"}
+CONTEXT_EVENTS = {"process_start", "startup", "write", "feedback", "intent",
+                  "intent_revision", "gesture_command", "diagnostic", "signal"}
+AFTER_EVENTS = {"runtime_failure", "process_failure", "worker_failure", "shutdown",
+                "process_exit", "log_summary", "diagnostic"}
+SECRET_KEY = re.compile(r"password|passwd|token|secret|credential|authorization|private.?key", re.I)
+SECRET_TEXT = re.compile(r"(?i)\b(password|passwd|token|secret|authorization)\s*[:=]\s*[^\s,;]+")
+
+
+def _encode(value):
+    return (json.dumps(value, ensure_ascii=False, allow_nan=False, separators=(",", ":")) + "\n").encode("utf-8")
+
+
+def _redact(value, depth=0):
+    if depth > 20:
+        return "[DEPTH_LIMIT]"
+    if isinstance(value, dict):
+        return {str(k): "[REDACTED]" if SECRET_KEY.search(str(k)) else _redact(v, depth+1)
+                for k, v in list(value.items())[:256]}
+    if isinstance(value, (list, tuple)):
+        return [_redact(v, depth+1) for v in value[:256]]
+    if isinstance(value, str):
+        return SECRET_TEXT.sub(r"\1=[REDACTED]", value[:131072])
+    return value
+
+
+def _event(row):
+    value = _redact(row)
+    data = _encode(value)
+    if len(data) <= MAX_EVENT_BYTES:
+        return value, len(data)
+    # Never quietly pretend an oversized diagnostic was fully retained.
+    value = {key: value.get(key) for key in ("event", "emitted_at", "stage", "exception_type", "error")}
+    value.update(archiveTruncated=True, originalBytes=len(data),
+                 excerpt=data[:32768].decode("utf-8", "replace"))
+    return value, len(_encode(value))
+
+
+def _regular(path):
+    try:
+        mode = path.lstat()
+        return stat.S_ISREG(mode.st_mode) and mode.st_nlink == 1
+    except OSError:
+        return False
+
+
+def _root(path):
+    path = Path(path).absolute()
+    if path == Path(path.anchor) or path.is_symlink():
+        raise ValueError("unsafe diagnostic root")
+    path.mkdir(mode=0o700, parents=True, exist_ok=True)
+    if path.is_symlink() or not path.is_dir():
+        raise ValueError("diagnostic root is not a directory")
+    return path
+
+
+@contextmanager
+def _lock(root):
+    fd = os.open(root / ".archive.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+    try:
+        if not stat.S_ISREG(os.fstat(fd).st_mode):
+            raise ValueError("invalid diagnostic lock")
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        yield
+    finally:
+        os.close(fd)
+
+
+def _records(root):
+    result = []
+    for path in root.iterdir():
+        if path.suffix != ".json" or not RUN_NAME.fullmatch(path.stem) or not _regular(path):
+            continue
+        size = path.stat().st_size
+        if size > MAX_RECORD_BYTES:
+            continue  # An untrusted/unrecognized file is never deleted.
+        try:
+            row = json.loads(path.read_bytes())
+            if (row.get("owner") != OWNER or row.get("schemaVersion") != VERSION or
+                    row.get("runName") != path.stem or type(row.get("createdAt")) not in (int, float) or
+                    type(row.get("failure")) is not bool or not math.isfinite(row["createdAt"])):
+                continue
+        except (OSError, ValueError, AttributeError):
+            continue
+        result.append((path, size, row))
+    return result
+
+
+def _prune_locked(root, *, now, max_bytes, max_age, reserve=0, protect=None,
+                  incoming_failure=True):
+    # Leftover atomic-write files are ours by exact name in this private pool.
+    for path in root.iterdir():
+        if TEMP_NAME.fullmatch(path.name) and _regular(path):
+            path.unlink()
+    records = _records(root)
+    retained = []
+    for path, size, row in records:
+        if path != protect and now-row["createdAt"] > max_age:
+            path.unlink()
+        else:
+            retained.append((path, size, row))
+    total = sum(size for _, size, _ in retained)
+    # Normal summaries go first; under pressure retain newest failures longest.
+    for path, size, row in sorted(retained, key=lambda item: (item[2]["failure"], item[2]["createdAt"], item[0].name)):
+        if total + reserve <= max_bytes:
+            break
+        if path == protect:
+            continue
+        if row["failure"] and not incoming_failure:
+            return False  # A new ordinary summary must not evict a real fault.
+        path.unlink()
+        total -= size
+    if total + reserve > max_bytes:
+        raise OSError("diagnostic archive quota cannot accommodate atomic update")
+    return True
+
+
+def prune_archive(root, *, now=None, max_bytes=MAX_BYTES, max_age=MAX_AGE_SECONDS):
+    root = _root(root)
+    with _lock(root):
+        _prune_locked(root, now=time.time() if now is None else now,
+                      max_bytes=max_bytes, max_age=max_age)
+
+
+class RunDiagnosticArchive:
+    def __init__(self, root, run_name, *, clock=time.time, max_bytes=MAX_BYTES,
+                 max_age=MAX_AGE_SECONDS, created_at=None):
+        if not RUN_NAME.fullmatch(run_name):
+            raise ValueError("invalid diagnostic run name")
+        if max_bytes < MAX_RECORD_BYTES * 2 or max_age <= 0:
+            raise ValueError("diagnostic quota is too small")
+        self.root = Path(root)
+        self.run_name = run_name
+        self.clock, self.max_bytes, self.max_age = clock, max_bytes, max_age
+        self.created_at = clock() if created_at is None else created_at
+        self.context = deque()
+        self.context_size = 0
+        self.first_failure = None
+        self.before_failure = []
+        self.after_failure = deque(maxlen=16)
+        self.error = None
+
+    def observe(self, row):
+        """Called only by the log writer; failures never escape to motor code."""
+        try:
+            event = row.get("event")
+            fault = event in FAULTS or event == "shutdown" and bool(row.get("failure"))
+            if event not in CONTEXT_EVENTS | AFTER_EVENTS and not fault:
+                return
+            value, size = _event(row)
+            if fault and self.first_failure is None:
+                self.first_failure = value
+                self.before_failure = [v for v, _ in self.context]
+            elif self.first_failure is not None and event in AFTER_EVENTS:
+                self.after_failure.append(value)
+            if self.first_failure is None and event in CONTEXT_EVENTS:
+                self.context.append((value, size)); self.context_size += size
+                while self.context_size > CONTEXT_BYTES or len(self.context) > 48:
+                    _, removed = self.context.popleft(); self.context_size -= removed
+            if fault or self.first_failure is not None and event in ("shutdown", "process_exit", "log_summary"):
+                self._save()
+            elif event == "process_exit":
+                self.after_failure.append(value)
+                self._save()  # Small normal summaries yield space to failures first.
+        except Exception as exc:
+            self.error = type(exc).__name__ + ": " + str(exc)[:160]
+
+    def _save(self):
+        now = self.clock()
+        # A late migration/cleanup must not refresh the seven-day lifetime.
+        if now-self.created_at > self.max_age:
+            return
+        record = dict(owner=OWNER, schemaVersion=VERSION, runName=self.run_name,
+                      createdAt=self.created_at, updatedAt=now, failure=self.first_failure is not None,
+                      firstFailure=self.first_failure, beforeFailure=self.before_failure,
+                      afterFailure=list(self.after_failure))
+        data = _encode(record)
+        while len(data) > MAX_RECORD_BYTES and record["afterFailure"]:
+            record["afterFailure"].pop(0); record["contextTruncated"] = True; data = _encode(record)
+        while len(data) > MAX_RECORD_BYTES and record["beforeFailure"]:
+            record["beforeFailure"].pop(0); record["contextTruncated"] = True; data = _encode(record)
+        if len(data) > MAX_RECORD_BYTES:
+            raise ValueError("diagnostic record exceeds bounded size")
+        root = _root(self.root)
+        path = root / (self.run_name + ".json")
+        with _lock(root):
+            if path.exists() or path.is_symlink():
+                valid = next((r for p, _, r in _records(root) if p == path), None)
+                if valid is None:
+                    raise ValueError("refusing to replace unrecognized diagnostic file")
+                if valid["failure"]:
+                    # A recreated writer/import must not replace the first persisted fault.
+                    record["failure"] = True
+                    record["firstFailure"] = valid["firstFailure"]
+                    record["beforeFailure"] = valid.get("beforeFailure", [])
+                    record["createdAt"] = valid["createdAt"]
+                    if self.first_failure != valid["firstFailure"]:
+                        record["afterFailure"] = (valid.get("afterFailure", []) + record["afterFailure"])[-16:]
+                    data = _encode(record)
+                    while len(data) > MAX_RECORD_BYTES and record["afterFailure"]:
+                        record["afterFailure"].pop(0); record["contextTruncated"] = True; data = _encode(record)
+                    if len(data) > MAX_RECORD_BYTES:
+                        raise ValueError("persisted diagnostic exceeds bounded size")
+                    if now-record["createdAt"] > self.max_age:
+                        _prune_locked(root, now=now, max_bytes=self.max_bytes, max_age=self.max_age)
+                        return
+            # Include the old version while reserving the complete new temp file,
+            # keeping even atomic replacement below the configured byte cap.
+            if not _prune_locked(root, now=now, max_bytes=self.max_bytes, max_age=self.max_age,
+                                 reserve=len(data), protect=path, incoming_failure=record["failure"]):
+                return
+            temporary = root / (".tmp_" + uuid.uuid4().hex + ".json")
+            try:
+                fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+                with os.fdopen(fd, "wb") as stream:
+                    stream.write(data); stream.flush(); os.fsync(stream.fileno())
+                os.replace(temporary, path)
+            finally:
+                if temporary.exists() and _regular(temporary):
+                    temporary.unlink()
+
+
+def archive_existing_run(directory, root):
+    """Explicit offline migration: stream evidence before disposable-run pruning.
+
+    The launcher never calls this scanner. The single runtime owner must be idle.
+    Streaming one bounded line at a time
+    avoids loading recordings or a complete multi-MB events file into memory.
+    """
+    directory = Path(directory)
+    events = directory / "events.jsonl"
+    if directory.is_symlink() or not _regular(events):
+        return
+    stamp = events.stat().st_mtime
+    match = re.match(r"run_(\d{8}_\d{6})_", directory.name)
+    if match:
+        try:
+            stamp = datetime.datetime.strptime(match.group(1), "%Y%m%d_%H%M%S").timestamp()
+        except ValueError:
+            pass
+    archive = RunDiagnosticArchive(root, directory.name, created_at=stamp)
+    destination = Path(root) / (directory.name + ".json")
+    if _regular(destination):
+        return  # The writer already captured this run; never replace its first fault.
+    with events.open("rb") as stream:
+        while True:
+            line = stream.readline(MAX_EVENT_BYTES + 1)
+            if not line:
+                break
+            if len(line) > MAX_EVENT_BYTES and not line.endswith(b"\n"):
+                while line and not line.endswith(b"\n"):
+                    line = stream.readline(MAX_EVENT_BYTES + 1)
+                continue
+            try:
+                row = json.loads(line)
+                if isinstance(row, dict):
+                    archive.observe(row)
+            except (ValueError, UnicodeError):
+                continue
+    if archive.error:
+        raise OSError("runtime diagnostic migration failed: " + archive.error)
