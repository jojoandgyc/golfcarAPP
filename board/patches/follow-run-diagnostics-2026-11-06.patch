@@ -0,0 +1,268 @@
+"""Pure temporary-filesystem tests: no serial, camera, SSH or real log roots."""
+import json
+import ast
+import os
+from pathlib import Path
+import tempfile
+import threading
+import time
+import unittest
+from unittest import mock
+
+from continuous_follow.telemetry import EventLog
+from tools.prepare_run_logs import prepare_run_directory
+from tools.runtime_diagnostics import (RunDiagnosticArchive, archive_existing_run,
+    prune_archive, MAX_AGE_SECONDS, MAX_RECORD_BYTES, MAX_BYTES)
+
+
+class RuntimeDiagnosticsTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.base = Path(self.temp.name)
+        self.root = self.base / "diagnostics"
+        self.now = time.time()
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def archive(self, name="run_test", **kwargs):
+        return RunDiagnosticArchive(self.root, name, clock=lambda: self.now, **kwargs)
+
+    def read(self, name="run_test"):
+        return json.loads((self.root / (name + ".json")).read_text())
+
+    def fault(self, **values):
+        return dict(event="runtime_failure", emitted_at=10., stage="motor_write",
+                    exception_type="TimeoutError", error="no response from driver", **values)
+
+    def test_preserves_exact_first_fault_wire_details_and_cleanup(self):
+        a = self.archive()
+        a.observe(dict(event="intent", left_rpm=44, right_rpm=42))
+        a.observe(dict(event="feedback", left_rpm=43, right_rpm=41))
+        motor = dict(last_transaction=dict(function="0x06", register="0x0052", stage="read",
+                     tx_written=8, rx_length=0, elapsed_ms=150.2), right_acknowledged=True,
+                     recent_wire=[dict(register="0x0051", acknowledged=True)])
+        first = self.fault(motor=motor, traceback="actual call stack")
+        a.observe(first)
+        a.observe(dict(event="runtime_failure", error="later cleanup failure"))
+        a.observe(dict(event="shutdown", cleanup_errors=[], stop_acks=[True, False]))
+        a.observe(dict(event="process_exit", exit_code=1))
+        row = self.read()
+        self.assertEqual(row["firstFailure"], first)
+        self.assertEqual(row["beforeFailure"][0]["left_rpm"], 44)
+        self.assertEqual(row["afterFailure"][-2]["stop_acks"], [True, False])
+        self.assertIsNone(a.error)
+
+    def test_failure_survives_many_subsequent_normal_run_rotations(self):
+        runs = self.base / "run_continuous_follow_logs"
+        first = prepare_run_directory(runs, migrate_legacy=False)
+        events = EventLog(first / "events.jsonl", diagnostic_root=self.root)
+        events.emit("runtime_failure", stage="motor_write", motor={"rx_length": 0})
+        events.emit("process_exit", exit_code=1)
+        events.close()
+        for _ in range(6):
+            new = prepare_run_directory(runs, migrate_legacy=False, diagnostic_archive_root=self.root)
+            log = EventLog(new / "events.jsonl", diagnostic_root=self.root)
+            log.emit("process_exit", exit_code=0); log.close()
+        self.assertFalse(first.exists())
+        saved = self.read(first.name)
+        self.assertTrue(saved["failure"])
+        self.assertEqual(saved["firstFailure"]["motor"], {"rx_length": 0})
+        self.assertEqual(len(list(runs.glob("run_*"))), 3)
+
+    def test_backfills_existing_failure_before_prune_without_loading_video(self):
+        runs = self.base / "run_continuous_follow_logs"
+        old = prepare_run_directory(runs, migrate_legacy=False)
+        (old / "events.jsonl").write_text(json.dumps(self.fault(motor={"register": "0x0052"})) + "\n")
+        (old / "camera_raw.avi").write_bytes(b"must not archive images")
+        for _ in range(3):
+            prepare_run_directory(runs, migrate_legacy=False, diagnostic_archive_root=self.root)
+        self.assertFalse(old.exists())
+        self.assertEqual(self.read(old.name)["firstFailure"]["motor"]["register"], "0x0052")
+        self.assertNotIn("must not archive", (self.root / (old.name + ".json")).read_text())
+
+    def test_age_expiry_survives_reopen_and_does_not_refresh_on_cleanup(self):
+        a = self.archive(); a.observe(self.fault())
+        original = self.read()["createdAt"]
+        self.now += MAX_AGE_SECONDS - 1
+        a.observe(dict(event="shutdown", failure=None))
+        self.assertEqual(self.read()["createdAt"], original)
+        self.now += 2
+        prune_archive(self.root, now=self.now)
+        self.assertFalse((self.root / "run_test.json").exists())
+        a.observe(dict(event="process_exit", exit_code=1))
+        self.assertFalse((self.root / "run_test.json").exists())
+
+    def test_byte_quota_evicts_normal_then_old_faults_and_keeps_newest(self):
+        budget = 4 * 1024 * 1024
+        normal = self.archive("run_normal", max_bytes=budget)
+        normal.observe(dict(event="process_exit", exit_code=0))
+        payload = {f"evidence_{i}": "a" * 100000 for i in range(4)}
+        for index in range(16):
+            self.now += 1
+            a = self.archive(f"run_fault_{index}", max_bytes=budget)
+            a.observe(self.fault(motor=payload))
+            self.assertIsNone(a.error)
+            self.assertLessEqual(sum(p.stat().st_size for p in self.root.glob("*.json")), budget)
+        self.assertFalse((self.root / "run_normal.json").exists())
+        self.assertFalse((self.root / "run_fault_0.json").exists())
+        self.assertTrue((self.root / "run_fault_15.json").exists())
+        self.assertFalse(list(self.root.glob(".tmp_*")))
+
