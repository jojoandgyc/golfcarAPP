+import json
+import fcntl
+from pathlib import Path
+import threading
+import time
+from unittest.mock import patch
+
+import numpy as np
+import pytest
+
+from rgbd_stream.camera_select import attached_cameras, resolve_camera, select_camera
+from rgbd_stream.capture import CameraBusyError, CaptureShutdownError
+from rgbd_stream.config import ROOT, load_config
+from rgbd_stream.gemini import Gemini335Source
+from rgbd_stream.http_api import stream_info
+from rgbd_stream.render import render_bundle
+from rgbd_stream.service import StreamRuntime
+
+
+def _usb(folder, name, vid, pid):
+    path = folder / name
+    path.mkdir()
+    (path / 'idVendor').write_text(vid)
+    (path / 'idProduct').write_text(pid)
+
+
+def test_auto_selects_only_present_camera_and_never_test_source(tmp_path):
+    _usb(tmp_path, 'camera', '2bc5', '0800')
+    attached = attached_cameras(tmp_path)
+    assert attached == {'gemini335'}
+    assert resolve_camera('auto', 'astra', attached) == 'gemini335'
+    with pytest.raises(RuntimeError, match='not connected'):
+        resolve_camera('astra', 'astra', attached)
+    assert resolve_camera('astra', 'astra', attached, allow_absent=True) == 'astra'
+    with pytest.raises(RuntimeError, match='No supported'):
+        resolve_camera('auto', 'synthetic', set())
+
+
+def test_auto_uses_current_camera_when_both_and_original_default_if_unknown():
+    both = {'astra', 'gemini335'}
+    assert resolve_camera('auto', 'gemini335', both) == 'gemini335'
+    assert resolve_camera('auto', 'synthetic', both) == 'astra'
+
+
+def test_selection_preserves_other_video_settings_and_uses_equal_scale(tmp_path):
+    _usb(tmp_path, 'camera', '2bc5', '0800')
+    cfg = load_config(ROOT / 'config/video.json')
+    cfg['video']['bitrate'] = 2_345_678
+    path = tmp_path / 'video.json'
+    path.write_text(json.dumps(cfg), encoding='utf-8')
+    assert select_camera(path, 'auto', sysfs_root=tmp_path) == 'gemini335'
+    selected = load_config(path)
+    assert selected['camera']['mode'] == 'gemini335'
+    assert selected['camera']['width'] == 1280
+    assert selected['camera']['height'] == 720
+    assert selected['render']['rgb_panel_width'] == 960
+    assert selected['render']['depth_panel_width'] == 960
+    assert selected['render']['output_height'] == 540
+    assert selected['video']['bitrate'] == 2_345_678
+    runtime = StreamRuntime(selected)
+    assert (runtime.width, runtime.height) == (1920, 540)
+    info = stream_info(type('Request', (), {'host': '127.0.0.1:8080', 'scheme': 'http'})(), runtime, selected)
+    assert (info['video']['width'], info['video']['height']) == (1920, 540)
+    assert info['video']['rgb_width'] == 960
+    assert info['source_mode'] == 'gemini335'
+    assert info['depth']['registration_requested'] is True
+    assert runtime.health()['source_mode'] == 'gemini335'
+
+
+def test_reselecting_same_camera_preserves_tuned_settings_and_file(tmp_path):
+    _usb(tmp_path, 'camera', '2bc5', '0403')
+    cfg = load_config(ROOT / 'config/video.json')
+    cfg['camera']['registration'] = True
+    cfg['camera']['device'] = '/dev/v4l/by-id/user-selected-astra'
+    cfg['render']['depth_panel_width'] = 700
+    path = tmp_path / 'video.json'
+    path.write_text(json.dumps(cfg), encoding='utf-8')
+    original = path.read_bytes()
+    assert select_camera(path, 'auto', sysfs_root=tmp_path) == 'astra'
+    assert path.read_bytes() == original
+
