+def test_render_resizes_both_panes_without_cropping_or_changing_depth_stats():
+    from rgbd_stream.frames import FrameBundle
+    rgb = np.zeros((720, 1280, 3), np.uint8)
+    rgb[:, :640] = (0, 0, 255)
+    depth = np.full((720, 1280), 2000, np.uint16)
+    bundle = FrameBundle(1, rgb, depth, 10.0, 10.0, True)
+    canvas, data = render_bundle(bundle, {
+        'rgb_panel_width': 960, 'depth_panel_width': 960, 'output_height': 540,
+    })
+    assert canvas.shape == (540, 1920, 3)
+    assert data['source_rgb_width'] == 1280 and data['source_rgb_height'] == 720
+    assert data['regions']['center']['median_m'] == 2.0
+    assert np.array_equal(bundle.rgb, rgb)
+    assert np.array_equal(bundle.depth_mm, depth)
+
