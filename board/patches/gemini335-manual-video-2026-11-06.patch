+def test_sdk_start_failure_closes_backend_and_camera_lock(tmp_path):
+    source = _source(tmp_path)
+    backend = FakeBackend(fail_start=True)
+    with patch('rgbd_stream.gemini.gemini335_usb_nodes', return_value=['/dev/fake-usb']), \
+            patch('rgbd_stream.gemini.camera_holders', return_value=[]), \
+            patch.object(source, '_make_backend', return_value=backend):
+        with pytest.raises(RuntimeError, match='fake SDK start failed'):
+            source.start()
+    assert backend.closed and not source.health()['ownership_lock_held']
+
+
+def test_sdk_close_failure_retains_camera_lock(tmp_path):
+    source = _source(tmp_path)
+    backend = FakeBackend(fail_close=True)
+    with patch('rgbd_stream.gemini.gemini335_usb_nodes', return_value=['/dev/fake-usb']), \
+            patch('rgbd_stream.gemini.camera_holders', return_value=[]), \
+            patch.object(source, '_make_backend', return_value=backend):
+        source.start()
+        with pytest.raises(CaptureShutdownError, match='lock retained'):
+            source.close()
+        assert source.health()['ownership_lock_held']
+        backend.fail_close = False
+        source.close()
+    assert not source.health()['ownership_lock_held']
+
