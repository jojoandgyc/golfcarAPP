+class FakeBackend:
+    def __init__(self, *, fail_start=False, fail_close=False):
+        self.fail_start, self.fail_close = fail_start, fail_close
+        self.started = False
+        self.closed = False
+        self.delivered = False
+        self.stop = threading.Event()
+        self.timestamp = time.monotonic()
+
+    def start(self):
+        if self.fail_start:
+            raise RuntimeError('fake SDK start failed')
+        self.started = True
+
+    def read_with_timestamp(self, timeout_sec=0.5):
+        if self.stop.wait(0.01):
+            return False, None, None
+        if self.delivered:
+            return False, None, None
+        self.delivered = True
+        return True, np.zeros((120, 160, 3), np.uint8), self.timestamp
+
+    def copy_depth_history(self, **kwargs):
+        return ((self.timestamp, np.full((120, 160), 1200, np.uint16)),)
+
+    def close(self):
+        if self.fail_close:
+            raise RuntimeError('fake SDK close failed')
+        self.stop.set()
+        self.closed = True
+
+
+def _source(tmp_path):
+    return Gemini335Source({
+        'mode': 'gemini335', 'width': 160, 'height': 120, 'fps': 10,
+        'lock_path': str(tmp_path / 'camera.lock'),
+    })
+
+
+def test_gemini_source_delivers_registered_pair_and_releases_sdk(tmp_path):
+    source = _source(tmp_path)
+    backend = FakeBackend()
+    with patch('rgbd_stream.gemini.gemini335_usb_nodes', return_value=['/dev/fake-usb']), \
+            patch('rgbd_stream.gemini.camera_holders', return_value=[]), \
+            patch.object(source, '_make_backend', return_value=backend):
+        source.start()
+        deadline = time.monotonic() + 1
+        frame = None
+        while frame is None and time.monotonic() < deadline:
+            frame = source.latest()
+            time.sleep(0.01)
+        assert frame is not None and frame.depth_registered
+        assert frame.depth_mm.shape == frame.rgb.shape[:2]
+        assert frame.rgb_timestamp == frame.depth_timestamp
+        assert source.health()['mode'] == 'gemini335'
+        assert source.health()['ownership_lock_held']
+        source.close()
+    assert backend.closed and not source.health()['ownership_lock_held']
+
+
+def test_busy_gemini_usb_never_opens_sdk_or_releases_other_lock(tmp_path):
+    source = _source(tmp_path)
+    with patch('rgbd_stream.gemini.gemini335_usb_nodes', return_value=['/dev/fake-usb']), \
+            patch('rgbd_stream.gemini.camera_holders', return_value=[456]), \
+            patch.object(source, '_make_backend') as make_backend:
+        with pytest.raises(CameraBusyError, match='camera busy'):
+            source.start()
+        make_backend.assert_not_called()
+    assert not source.health()['ownership_lock_held']
+
+
+def test_gemini_video_lock_owned_by_other_process_blocks_sdk(tmp_path):
+    source = _source(tmp_path)
+    lock_path = tmp_path / 'camera.lock'
+    with lock_path.open('w') as other:
+        fcntl.flock(other, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        with patch.object(source, '_make_backend') as make_backend:
+            with pytest.raises(CameraBusyError, match='another video instance'):
+                source.start()
+            make_backend.assert_not_called()
+        assert not source.health()['ownership_lock_held']
+        with lock_path.open('r') as contender:
+            with pytest.raises(BlockingIOError):
+                fcntl.flock(contender, fcntl.LOCK_EX | fcntl.LOCK_NB)
+
