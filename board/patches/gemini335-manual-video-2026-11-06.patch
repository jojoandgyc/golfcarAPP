+def test_missing_gemini_first_pair_never_reports_ready(tmp_path):
+    source = _source(tmp_path)
+    backend = FakeBackend()
+    backend.delivered = True
+    with patch('rgbd_stream.gemini.gemini335_usb_nodes', return_value=['/dev/fake-usb']), \
+            patch('rgbd_stream.gemini.camera_holders', return_value=[]), \
+            patch.object(source, '_make_backend', return_value=backend):
+        source.start()
+        time.sleep(0.08)
+        assert source.latest() is None
+        assert source.health()['frame_id'] is None
+        source.close()
