--- a/rgbd_stream/camera_select.py
+++ b/rgbd_stream/camera_select.py
@@ -0,0 +1,92 @@
+"""Resolve a physical RGB-D camera before starting the standalone video service."""
+import argparse
+import json
+import os
+from pathlib import Path
+
+from .config import ROOT, load_config
+
+PROFILES = ROOT / "config/camera_profiles.json"
+USB_IDS = {"astra": ("2bc5", "0403"), "gemini335": ("2bc5", "0800")}
+
+
+def attached_cameras(sysfs_root=Path("/sys/bus/usb/devices")):
+    found = set()
+    try:
+        devices = list(Path(sysfs_root).iterdir())
+    except OSError:
+        return found
+    for device in devices:
+        try:
+            identity = ((device / "idVendor").read_text().strip().lower(),
+                        (device / "idProduct").read_text().strip().lower())
+        except OSError:
+            continue
+        for mode, expected in USB_IDS.items():
+            if identity == expected:
+                found.add(mode)
+    return found
+
+
+def resolve_camera(requested, configured, attached, *, allow_absent=False):
+    if requested not in {"auto", "astra", "gemini335"}:
+        raise ValueError("camera must be auto, astra or gemini335")
+    if requested != "auto":
+        if requested not in attached and not allow_absent:
+            raise RuntimeError(f"{requested} camera is not connected; attached={','.join(sorted(attached)) or 'none'}")
+        return requested
+    if configured in attached:
+        return configured
+    if len(attached) == 1:
+        return next(iter(attached))
+    if len(attached) > 1:
+        return "astra"  # Preserve the original default when both are attached.
+    raise RuntimeError("No supported Astra Pro or Gemini 335 USB camera is connected")
+
+
+def apply_profile(cfg, selected):
+    profiles = json.loads(PROFILES.read_text(encoding="utf-8"))
+    profile = profiles[selected]
+    cfg["camera"] = dict(profile["camera"])
+    cfg["render"].update(profile["render"])
+    from .config import validate_config
+    return validate_config(cfg)
+
+
+def select_camera(config_path, requested, *, sysfs_root=Path("/sys/bus/usb/devices"),
+                  allow_absent=False):
+    config_path = Path(config_path)
+    cfg = load_config(config_path)
+    selected = resolve_camera(requested, cfg["camera"]["mode"], attached_cameras(sysfs_root),
+                              allow_absent=allow_absent)
+    if selected == cfg["camera"]["mode"]:
+        # Preserve per-camera local tuning on repeated start, including
+        # registration and UVC device selection. Switching profiles is the
+        # only operation that replaces camera-specific values.
+        return selected
+    # Keep remaining render/video/HTTP values and control-independent settings.
+    apply_profile(cfg, selected)
+    temp = config_path.with_name(config_path.name + f".{os.getpid()}.tmp")
+    try:
+        temp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+        os.chmod(temp, config_path.stat().st_mode & 0o777)
+        os.replace(temp, config_path)
+    finally:
+        temp.unlink(missing_ok=True)
+    return selected
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", default=str(ROOT / "config/video.json"))
+    parser.add_argument("--camera", required=True, choices=("auto", "astra", "gemini335"))
+    parser.add_argument("--allow-absent", action="store_true", help="Only for configuring a stopped service")
+    args = parser.parse_args(argv)
+    try:
+        print(select_camera(args.config, args.camera, allow_absent=args.allow_absent))
+    except (OSError, RuntimeError, ValueError, KeyError) as exc:
+        parser.exit(2, f"Video camera selection failed: {exc}\n")
+
+
+if __name__ == "__main__":
+    main()
