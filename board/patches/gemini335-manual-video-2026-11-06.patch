@@ -0,0 +1,143 @@
+"""Gemini 335 RGB-D preview using the car runtime's already validated SDK adapter.
+
+The same SDK Pipeline produces registered RGB and depth. This service owns it
+only while the manual video source runs; no motor or follow runtime is opened.
+"""
+import fcntl
+import logging
+import os
+from pathlib import Path
+import sys
+import threading
+
+import numpy as np
+
+from .capture import (_LatestSource, CameraBusyError, CaptureShutdownError,
+                      camera_holders, gemini335_usb_nodes)
+from .frames import FrameBundle
+
+LOG = logging.getLogger(__name__)
+
+
+class Gemini335Source(_LatestSource):
+    def __init__(self, camera):
+        super().__init__(camera)
+        self._backend = None
+        self._lock_path = Path(camera.get('lock_path', '/home/topeet/Desktop/video/run/camera.lock')).expanduser()
+        self._lock_fd = None
+        self._depth_registered = False
+
+    def _acquire_camera_lock(self):
+        self._lock_path.parent.mkdir(parents=True, exist_ok=True)
+        fd = os.open(self._lock_path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            os.close(fd)
+            raise CameraBusyError(f'camera busy: another video instance holds {self._lock_path}') from exc
+        except BaseException:
+            os.close(fd)
+            raise
+        self._lock_fd = fd
+
+    def _make_backend(self):
+        module_path = str(self.camera.get('runtime_module_path', '/home/topeet/Desktop/rk_car_runtime_module'))
+        if module_path not in sys.path:
+            sys.path.insert(0, module_path)
+        from car_control_modular.astra_depth import AstraDepthConfig
+        from car_control_modular.gemini335_rgbd import Gemini335Config, Gemini335Runtime
+        depth_config = AstraDepthConfig(
+            width=self.width, height=self.height, fps=self.fps,
+            rgb_processing_delay_sec=0.0,
+        )
+        keys = Gemini335Config.__dataclass_fields__
+        native_config = Gemini335Config(**{
+            key: self.camera[key] for key in keys if key in self.camera
+        })
+        return Gemini335Runtime(depth_config, native_config, logger=LOG)
+
+    def start(self):
+        with self._lifecycle_lock:
+            if self._lock_fd is not None:
+                raise CameraBusyError('Gemini335 source is already started or still requires a successful close')
+            self._prepare_start()
+            self._depth_registered = False
+            try:
+                self._acquire_camera_lock()
+                nodes = gemini335_usb_nodes()
+                if not nodes:
+                    raise RuntimeError('Gemini335 USB device 2bc5:0800 is not connected')
+                for node in nodes:
+                    holders = camera_holders(node)
+                    if holders:
+                        raise CameraBusyError(f'camera busy: {node}; held by PIDs {holders}; no device was opened')
+                backend = self._make_backend()
+                self._backend = backend
+                backend.start()
+                self._depth_registered = True  # Gemini SDK D2C registration was requested and validated.
+                with self._lock:
+                    self._state = 'running'
+                self._threads = [threading.Thread(target=self._read_pairs, name='rgbd-gemini335', daemon=True)]
+                self._threads[0].start()
+            except Exception as exc:
+                self._fail(exc)
+                self.close()
+                raise
+
+    def _read_pairs(self):
+        seq = 0
+        try:
+            while not self._stop.is_set():
+                ok, rgb, timestamp = self._backend.read_with_timestamp(timeout_sec=0.5)
+                if not ok or rgb is None or timestamp is None:
+                    continue
+                # Gemini335Runtime publishes the registered depth under the
+                # exact timestamp returned with this BGR frame. Never pair it
+                # with a later, unrelated depth sample.
+                samples = self._backend.copy_depth_history(
+                    after_timestamp=max(0.0, float(timestamp) - 0.000001), max_frames=16)
+                pair = next(((stamp, depth) for stamp, depth in reversed(samples)
+                             if abs(stamp - timestamp) <= 0.000001), None)
+                if pair is None:
+                    continue
+                if rgb.shape[:2] != (self.height, self.width) or pair[1].shape != (self.height, self.width):
+                    raise RuntimeError('Gemini335 RGB/D2C dimensions changed during capture')
+                if rgb.dtype != np.uint8 or pair[1].dtype != np.uint16:
+                    raise RuntimeError('Gemini335 RGB/D2C pixel format changed during capture')
+                seq += 1
+                rgb = np.ascontiguousarray(rgb).copy()
+                rgb.flags.writeable = False
+                depth = pair[1]
+                depth.flags.writeable = False
+                with self._lock:
+                    self._latest = FrameBundle(seq, rgb, depth, float(timestamp), float(pair[0]), True)
+                    self._last_rgb = float(timestamp)
+                    self._last_depth = float(pair[0])
+        except Exception as exc:
+            if not self._stop.is_set():
+                self._fail(exc)
+
+    def close(self):
+        with self._lifecycle_lock:
+            if not self._join_readers():
+                raise CaptureShutdownError(self._error or 'Gemini335 reader did not stop')
+            if self._backend is not None:
+                try:
+                    self._backend.close()
+                except Exception as exc:
+                    message = 'Gemini335 SDK close failed; camera ownership lock retained'
+                    with self._lock:
+                        self._state, self._error = 'error', message
+                    raise CaptureShutdownError(message) from exc
+                self._backend = None
+            if self._lock_fd is not None:
+                os.close(self._lock_fd)
+                self._lock_fd = None
+
+    def health(self):
+        result = super().health()
+        result.update(source='gemini335', synthetic=False,
+                      device=self.camera.get('device'),
+                      depth_registered=self._depth_registered,
+                      ownership_lock_held=self._lock_fd is not None)
+        return result
